#!/usr/bin/env bash
# Push one experiment tag (SFT checkpoint + tokenizer + config + logs +
# eval JSONs + owned annotator matrices) to HuggingFace Hub.
#
# Target: unswnlporg/tor-simt-{tag}  (private by default).
# Requires write access to the unswnlporg organisation
# (join at https://huggingface.co/unswnlporg).
#
# Usage:
#   bin/11_push_to_hub --config configs/{NN_tag}.yaml [--public] [--dry_run]
#     [--org OTHER_ORG] [--repo_name OVERRIDE]
#
# Steps before first push:
#   1. Join unswnlporg on HuggingFace and request write role from Dipankar.
#   2. huggingface-cli login   (personal token with write scope)
#   3. bin/11_push_to_hub --config configs/{NN_tag}.yaml --dry_run   (verify)
#   4. bin/11_push_to_hub --config configs/{NN_tag}.yaml             (push)

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${DIR}/_env.sh"
exec "${PYTHON}" -u "${SIMT_REPO_ROOT}/scripts/11_push_to_hub.py" "$@"
