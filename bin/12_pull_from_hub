#!/usr/bin/env bash
# Pull an experiment tag's artifacts from HuggingFace Hub — companion to
# bin/11_push_to_hub. Reverses the upload into the local tree.
#
# Source: unswnlporg/tor-simt-{tag}  (defaults to the same org as push).
# Requires read access to the private repo (unswnlporg membership).
#
# Usage:
#   bin/12_pull_from_hub --tag {tag}  [--only annotate|model|logs|eval|all] [--force]
#     # or explicit repo:
#   bin/12_pull_from_hub --repo {org}/{name} [--only ...]
#
# Common uses (local tags use underscores; HF repo names use hyphens —
# translation is automatic):
#
#   # Quang: pull Dipankar's Gemma-2B annotator matrices for cross-annot experiments
#   bin/12_pull_from_hub --tag gemma_2b_curated --only annotate
#     → pulls from unswnlporg/tor-simt-gemma-2b-curated
#     → drops matrices into results/annotate/gemma-4-E2B-it/{pair}/matrices.jsonl
#
#   # Full pull (annot matrices + model + logs + evals):
#   bin/12_pull_from_hub --tag gemma_2b_curated

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${DIR}/_env.sh"
exec "${PYTHON}" -u "${SIMT_REPO_ROOT}/scripts/12_pull_from_hub.py" "$@"
