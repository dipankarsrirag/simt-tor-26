#!/usr/bin/env bash
# Download the CURATED training corpus (europarl-v10 + news-commentary-v16 +
# TED2020 across 8 language pairs). See scripts/01_download_training_data.sh for
# per-source details.
#
# Usage: bin/01_download_training_data
# Custom target: SIMT_CORPUS_ROOT=/path/to/data bin/01_download_training_data

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${DIR}/_env.sh"
exec bash "${SIMT_REPO_ROOT}/scripts/01_download_training_data.sh" "$@"
