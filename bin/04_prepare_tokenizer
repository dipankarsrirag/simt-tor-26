#!/usr/bin/env bash
# One-time — extend a backbone's tokenizer with EOR/EOW special tokens.
# Reads: HF backbone
# Writes: results/train/{tag}/tokenizer/ (or path from --output)
#
# Usage: bin/04_prepare_tokenizer --backbone google/gemma-4-E2B-it --output results/train/{tag}/tokenizer/

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${DIR}/_env.sh"
exec "${PYTHON}" -u "${SIMT_REPO_ROOT}/scripts/04_prepare_tokenizer.py" "$@"
