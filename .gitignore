# Data — never committed. `data/` is a symlink to
# /g/data/po67/dipankar/data/simt-tor-26/.
data/
data
*.arrow
*.parquet
*.jsonl.gz
*.tsv.gz

# Model weights and checkpoints.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
checkpoints/
runs/
# Phase-2 trained-model output dirs — regeneratable via src/train/sft.py.
# Keep only sft_summary.json / train_indices.json per run (staged explicitly).
results/train/**/checkpoint-*/
_archive/results/**/checkpoint-*/
results/train/**/final/
_archive/results/**/final/
# Phase-2 in-progress annotation — commit after all shards complete.
# (old n2k paths archived)



# Ad-hoc / superseded / diagnostic SFT dirs — not durable.




# Logs — PBS output, metrics jsonl, wandb offline dirs.
logs/
*.log
*.o[0-9]*
*.e[0-9]*
wandb/

# Python / venv.
__pycache__/
*.pyc
*.pyo
.venv/
.venv-*/
*.egg-info/
.eggs/
build/
dist/

# Editor / OS junk.
.DS_Store
.idea/
.vscode/
*.swp

# AI-assistant local instructions — not part of the shipped repo.
CLAUDE.md
.claude/

# Secrets — never commit.
.env
.env.*
*.key
*.pem
credentials.json

# uv cache / lock artefacts we do not want checked in.
.uv_cache/

# Local scratch — do not commit half-baked notebooks or manuscript PDFs.
*.ipynb_checkpoints/
*.pdf
scratch/

# Large regeneratable intermediate — GPT-4 per-sentence Pearson on 660K rows.
# Rebuild in ~2 min via scripts/phase1_precompute_gpt4_pearson.py.
# 99 MB — HOUSEKEEPING §7.1 <10 MB rule.
results/gate1/gpt4_pearson_full.json
_archive/results/phase1/gate1/gpt4_pearson_full.json

# Ad-hoc dry-runs — not part of the durable Gate-1 record.
results/gate1/*_dryrun.json

# Extended tokenizer.json files are 20-30MB each; regeneratable via
# bin/04_prepare_tokenizer in seconds. Keep the manifest + tokenizer_config,
# not the vocab blob. Covers both legacy `tokenizer-*` and canonical
# `results/train/{tag}/tokenizer/` layouts.
results/**/tokenizer-*/tokenizer.json
results/train/**/tokenizer/tokenizer.json

# Extrinsic eval outputs — hypothesis arrays are large; regeneratable via
# src/eval/extrinsic.py. Score/config JSONs may be added back explicitly
# once the numbers are paper-ready.
results/eval/**/*.json
_archive/results/**/extrinsic/

# Annotator matrices — 100-300MB each, regeneratable via src/annotator/annotate.py.
# HOUSEKEEPING §7.1 <10MB rule.
results/annotate/**/matrices.jsonl
_archive/results/**/annot_ot_*/matrices.jsonl

# SFT training datasets — 44-89MB each, regeneratable via scripts/phase2_build_sft_dataset.py.
results/sft_dataset/**/*.json
_archive/results/**/sft_dataset_*.json

# Multilingual source pool — 38MB, regeneratable via scripts/phase2_build_multilingual_source_pool.py.



# Extended tokenizer — 31MB tokenizer.json regeneratable via scripts/phase2_build_tokenizer_v6.py.
_archive/results/**/tokenizer-extended-v6/


# Live per-tag log dirs — everything except placeholder .gitkeep.
logs/*/**/*.log

# Per-user site config (see .simtrc.example).
.simtrc
