#!/bin/bash
#PBS -N phase2_sft_multilingual_v5
#PBS -P po67
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=05:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/phase2_sft_multilingual_v5.log

# Multilingual v5 SFT — 1 epoch, no early stopping, aggressive batch on H200.
# Data: sft_dataset_multilingual_v5.json (~150K rows across 10 directions, OT-annotated).
# Recipe: v4 stack (fixed_tokenization + descriptive_init + Test B α=5) + EAST-style 1-epoch.
# Batch: 16 per device × 4 grad_accum = effective 64 (4× v4). H200 has plenty of headroom.
# Expected: ~2,300 steps at ~10-15 steps/min = 2.5-4h SFT + 2min smoke.

set -eo pipefail
mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs

export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export HF_DATASETS_CACHE=/g/data/po67/dipankar/cache/datasets
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export TRITON_CACHE_DIR=/g/data/po67/dipankar/cache/triton
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export PIP_CACHE_DIR=/g/data/po67/dipankar/cache/pip
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $HF_HOME $HF_HUB_CACHE $TRANSFORMERS_CACHE $HF_DATASETS_CACHE \
         $TORCH_HOME $TRITON_CACHE_DIR $PIP_CACHE_DIR $TMPDIR

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

export OMP_NUM_THREADS=${PBS_NCPUS:-12}
export MKL_NUM_THREADS=${PBS_NCPUS:-12}

OUT_DIR=results/phase2/sft_multilingual_v5
STATE_DIR=$OUT_DIR/pbs_state
DONE_MARKER=$STATE_DIR/DONE
mkdir -p "$STATE_DIR"

if [ -f "$OUT_DIR/final/config.json" ]; then
    echo "SKIP: $OUT_DIR/final/ already exists."
    touch "$DONE_MARKER"
    exit 0
fi

# Chain-at-START — safety net for walltime kill; sft.py auto-resumes from latest
# checkpoint-*/ dir via HF Trainer's resume_from_checkpoint. DONE marker short-
# circuits chained shards once final/ is written.
SHARD_COUNTER=$STATE_DIR/shard_counter
SHARD_N=$(cat "$SHARD_COUNTER" 2>/dev/null || echo 0)
SHARD_N=$((SHARD_N + 1))
echo "$SHARD_N" > "$SHARD_COUNTER"
MAX_SHARDS=2

if [ ! -f "$DONE_MARKER" ] && [ "$SHARD_N" -lt "$MAX_SHARDS" ]; then
    NEXT_JOB=$(qsub -W depend=afterany:$PBS_JOBID jobs/phase2_sft_multilingual_v5.pbs)
    echo "Shard $SHARD_N of $MAX_SHARDS. Next queued: $NEXT_JOB"
fi

python -u src/train/sft.py \
    --corpus_file results/phase2/sft_dataset_multilingual_v5.json \
    --per_device_batch_size 16 \
    --grad_accum_steps 4 \
    --num_epochs 1.0 \
    --warmup_steps 200 \
    --logging_steps 50 \
    --eval_steps 100 \
    --early_stopping_patience 999999 \
    --learning_rate 2e-5 \
    --output_dir $OUT_DIR \
    --keep_checkpoints \
    --sample_generations 3 \
    --fixed_tokenization \
    --descriptive_init \
    --special_token_loss_weight 5.0 \
    --post_train_smoke_sents 100

if [ -f "$OUT_DIR/final/config.json" ]; then
    touch "$DONE_MARKER"
    echo "SFT complete — marker written to $DONE_MARKER"
    for p in "$OUT_DIR"/checkpoint-*; do
        [ -d "$p" ] && rm -rf "$p" && echo "Removed $p"
    done
fi
