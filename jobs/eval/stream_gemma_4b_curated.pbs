#!/bin/bash
#PBS -N eval_gemma_4b_curated
#PBS -l select=1:ncpus=8:mem=100gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

# Config 05 (Fig 4 middle). Gemma-4-E4B-it trained on its own OT chunks.
# Runs on UNSW Katana (PBS), not Gadi. Put the walltime on the qsub command
# line as well: Katana picks the queue tier from it.
# One eval cell. Pass TS (wmt15|wmt22|iwslt17|iwslt15), PAIR (de-en) and
# LAT (low|low-medium|medium|medium-high|high) with qsub -v. Skips cells that
# already have output, so the sweep can be resubmitted.

set -eo pipefail
cd ${SIMT_REPO_ROOT:-$PBS_O_WORKDIR}
OUT=results/eval/gemma_4b_curated
mkdir -p $OUT
JSON=$OUT/${TS}_stream_gemma_4b_curated_check_argmax_${LAT}_${PAIR}.json
[ -s $JSON ] && exit 0
SRC_L=${PAIR%-*}
TGT_L=${PAIR#*-}

source bin/_env.sh
${PYTHON} -u src/eval/extrinsic.py   --model_dir      results/train/gemma_4b_curated/final   --tokenizer_dir  results/train/gemma_4b_curated/tokenizer   --dev_src        ${SIMT_TESTSETS_ROOT}/eval/${PAIR}/${TS}.${PAIR}.src   --dev_ref        ${SIMT_TESTSETS_ROOT}/eval/${PAIR}/${TS}.${PAIR}.ref   --n_sentences    -1   --src_lang $SRC_L --tgt_lang $TGT_L   --use_chat_template   --latency  $LAT   --mode     streaming   --policy   check_argmax   --output   $JSON
