#!/bin/bash
#PBS -N sft_gemma_4b_from_2b_annot
#PBS -l select=1:ncpus=8:mem=100gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

# Config 06 (Fig 5 middle). Gemma-4-E4B-it trained on Gemma-2B's OT chunks.
# Runs on UNSW Katana (PBS), not Gadi. Put the walltime on the qsub command
# line as well: Katana picks the queue tier from it.
# Trains in 2h shards. Each shard queues the next one before it starts and
# stops the chain once final/ exists. SIMT_SAVE_ONLY_MODEL drops the optimizer
# state from checkpoints (16GB instead of 41GB), which the 128GB scratch quota
# needs; with it the last checkpoint is kept, not the best-by-eval-loss one.
# Pass SHARD and MAX_SHARDS with qsub -v.

set -eo pipefail
cd ${SIMT_REPO_ROOT:-$PBS_O_WORKDIR}
OUT=results/train/gemma_4b_from_2b_annot
SHARD=${SHARD:-1}
MAX_SHARDS=${MAX_SHARDS:-12}

if [ ! -d $OUT/final ] && [ $SHARD -lt $MAX_SHARDS ]; then
  qsub -l walltime=02:00:00 -l select=1:ncpus=8:mem=100gb:ngpus=1     -v SHARD=$((SHARD+1)),MAX_SHARDS=$MAX_SHARDS     -W depend=afterany:$PBS_JOBID jobs/train/sft_gemma_4b_from_2b_annot.pbs
fi
[ -d $OUT/final ] && exit 0

source bin/_env.sh
SIMT_SAVE_ONLY_MODEL=1 ${PYTHON} -u src/train/sft.py   --corpus_file    results/sft_dataset/gemma_4b_from_2b_annot/sft_dataset.json   --model_path     ${SIMT_MODEL_BASE}/gemma-4-E4B-it   --tokenizer_dir  results/train/gemma_4b_from_2b_annot/tokenizer   --output_dir     $OUT   --num_epochs                  2   --per_device_batch_size       2   --grad_accum_steps            8   --learning_rate               1.5e-5   --warmup_steps                150   --eval_steps                  250   --early_stopping_patience     3
