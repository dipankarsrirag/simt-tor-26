#!/bin/bash
#PBS -N sft_llama_3_8b_waitk
#PBS -P ba39
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/sft_llama_3_8b_waitk.log

# Config 03 (EAST↺waitk) — SFT Llama-3-8B-Instruct on procedural wait-k chunks.
# Corpus: same 80K curated rows, 3× replicated by latency (k=3/5/7), so
# ~234K training rows. Same recipe as Config 01 for a matched head-to-head.

set -eo pipefail
cd /g/data/ba39/dipankar/simt-tor-26
export SIMT_REPO_ROOT=/g/data/ba39/dipankar/simt-tor-26
source jobs/env.sh

python3 -u src/train/sft.py \
    --corpus_file    results/sft_dataset/llama_3_8b_waitk/sft_dataset.json \
    --model_name     /g/data/po67/dipankar/models/Meta-Llama-3-8B-Instruct \
    --tokenizer_dir  /g/data/po67/dipankar/models/Meta-Llama-3-8B-Instruct-extended-v6 \
    --output_dir     results/train/llama_3_8b_waitk \
    --num_train_epochs               2 \
    --per_device_train_batch_size    2 \
    --gradient_accumulation_steps    8 \
    --learning_rate                  1e-5 \
    --warmup_steps                   200 \
    --eval_steps                     500 \
    --save_steps                     500 \
    --bf16
