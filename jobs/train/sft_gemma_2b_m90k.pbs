#!/bin/bash
#PBS -N sft_gemma_2b_m90k
#PBS -l select=1:ncpus=8:mem=100gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe

# Config 09. gemma-4-E2B-it on Multi-90K's GPT-4 chunks, all four directions
# (de-en, en-de, ru-en, en-ru) in one training set.
# Runs on UNSW Katana (PBS), not Gadi. Trains in 2h shards: each shard queues
# the next before it starts and stops once final/ exists.

set -eo pipefail
cd ${SIMT_REPO_ROOT:-$PBS_O_WORKDIR}
OUT=results/train/gemma_2b_m90k
SHARD=${SHARD:-1}
MAX_SHARDS=${MAX_SHARDS:-10}

source bin/_env.sh

# A full fine-tune of this backbone needs about 70GB. Some nodes advertise a
# large GPU but carry a 40GB card, so check the real size first. A shard that
# lands on a small card requeues itself at the same shard number, which keeps
# the chain intact; after too many bounces it asks for an H200 by name.
GPU_GB=$(${PYTHON} -c "import torch; print(int(torch.cuda.get_device_properties(0).total_memory / 2**30))")
BOUNCE=${BOUNCE:-0}
if [ "$GPU_GB" -lt 80 ]; then
  echo "GPU has ${GPU_GB}GB, need 80GB - requeueing (bounce $BOUNCE)"
  if [ "$BOUNCE" -lt 25 ]; then
    qsub -l walltime=02:00:00 -l select=1:ncpus=8:mem=100gb:ngpus=1       -v SHARD=$SHARD,MAX_SHARDS=$MAX_SHARDS,BOUNCE=$((BOUNCE+1)) jobs/train/sft_gemma_2b_m90k.pbs
  else
    qsub -l walltime=02:00:00 -l select=1:ncpus=8:mem=100gb:ngpus=1:gpu_model=H200       -v SHARD=$SHARD,MAX_SHARDS=$MAX_SHARDS jobs/train/sft_gemma_2b_m90k.pbs
  fi
  exit 0
fi

if [ ! -d $OUT/final ] && [ $SHARD -lt $MAX_SHARDS ]; then
  qsub -l walltime=02:00:00 -l select=1:ncpus=8:mem=100gb:ngpus=1     -v SHARD=$((SHARD+1)),MAX_SHARDS=$MAX_SHARDS     -W depend=afterany:$PBS_JOBID jobs/train/sft_gemma_2b_m90k.pbs
fi
[ -d $OUT/final ] && exit 0

SIMT_SAVE_ONLY_MODEL=1 ${PYTHON} -u src/train/sft.py   --corpus_file    results/sft_dataset/gemma_2b_m90k/sft_dataset.json   --model_path     ${SIMT_MODEL_BASE}/gemma-4-E2B-it   --tokenizer_dir  results/train/gemma_2b_m90k/tokenizer   --output_dir     $OUT   --num_epochs                  2   --per_device_batch_size       2   --grad_accum_steps            8   --learning_rate               2e-5   --warmup_steps                150   --eval_steps                  250   --early_stopping_patience     3
