#!/bin/bash
#PBS -N build_htgt_sft
#PBS -P ba39
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=20GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/build_htgt_sft.log

set -eo pipefail
export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $TMPDIR
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

CORPUS=results/phase2/multilingual_source_pool_htgt.json

# 8 htgt matrices (new) + 4 v6b matrices (reused for ar/vi)
MATRICES="\
    results/phase2/annot_ot_multi_htgt_de-en/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_de-en_b/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_en-de/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_en-de_b/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_ru-en/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_ru-en_b/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_en-ru/matrices.jsonl \
    results/phase2/annot_ot_multi_htgt_en-ru_b/matrices.jsonl \
    results/phase2/annot_ot_multi_ar-en/matrices.jsonl \
    results/phase2/annot_ot_multi_en-ar/matrices.jsonl \
    results/phase2/annot_ot_multi_vi-en/matrices.jsonl \
    results/phase2/annot_ot_multi_en-vi/matrices.jsonl"

# For corpus_by_idx to resolve ar/vi (still using v6b pool indices),
# we need a combined corpus JSON. Build it once now.
python3 -c "
import json
htgt = json.load(open('results/phase2/multilingual_source_pool_htgt.json'))
print(f'htgt pool: {len(htgt):,} rows')
seen = {r['index'] for r in htgt}
# The htgt pool ALREADY includes v6b ar/vi rows (we copied them). Verify.
langs = {}
for r in htgt:
    d = r.get('direction') or f\"{r['src_lang'].lower()[:2]}-{r['tgt_lang'].lower()[:2]}\"
    langs[d] = langs.get(d, 0) + 1
print('Directions:', langs)
"

# Build 3 tau-shards
for cfg in "0.30:high:4" "0.40:medium:3" "0.60:low:2"; do
    IFS=":" read TAU LAT MSW <<< "$cfg"
    OUT=results/phase2/sft_dataset_multilingual_v6b_htgt_tau${TAU//./p}_${LAT}.json
    if [ -f "$OUT" ]; then echo "SKIP: $OUT exists"; continue; fi
    echo ""
    echo "=== Building shard τ=$TAU lat=$LAT min_src_words=$MSW ==="
    python -u scripts/phase2_build_sft_dataset.py \
        --matrices $MATRICES \
        --corpus_json $CORPUS \
        --tau $TAU --tau_fallbacks "" \
        --keep_collapsed \
        --refine_boundaries --refine_window 3 --refine_alpha 1 --refine_beta 1 \
        --merge_small_chunks --min_src_words $MSW --min_src_chars_cjk 6 \
        --merge_stranded_function_words \
        --force_latency $LAT \
        --output $OUT
done

# Concat 3 shards
FINAL=results/phase2/sft_dataset_multilingual_v6b_htgt_final.json
if [ ! -f "$FINAL" ]; then
    echo ""
    echo "=== Concatenating 3 shards → $FINAL ==="
    python3 -c "
import json
shards = [
    'results/phase2/sft_dataset_multilingual_v6b_htgt_tau0p30_high.json',
    'results/phase2/sft_dataset_multilingual_v6b_htgt_tau0p40_medium.json',
    'results/phase2/sft_dataset_multilingual_v6b_htgt_tau0p60_low.json',
]
all_rows = []
for s in shards:
    r = json.load(open(s))
    print(f'  {s}: {len(r):,} rows')
    all_rows.extend(r)
print(f'  TOTAL: {len(all_rows):,} rows')
with open('$FINAL', 'w') as f:
    json.dump(all_rows, f, ensure_ascii=False)
print(f'Written: $FINAL')
"
fi

echo ""
echo "=== Final dataset ==="
ls -lh $FINAL 2>/dev/null
