#!/bin/bash
#PBS -N phase2_annot_ot_condB_n10k_shard
#PBS -P po67
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/phase2_annot_ot_condB_n10k_shard.log

# Queue: gpuhopper | GPU: H200-141GB x1
# Auto-calibrated: 12 CPUs, 240GB RAM, 120GB jobfs

set -eo pipefail
mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs

# Shared po67 cache — persists across scratch purges, shared with sibling projects.
export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export HF_DATASETS_CACHE=/g/data/po67/dipankar/cache/datasets
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export TRITON_CACHE_DIR=/g/data/po67/dipankar/cache/triton
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export PIP_CACHE_DIR=/g/data/po67/dipankar/cache/pip
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $HF_HOME $HF_HUB_CACHE $TRANSFORMERS_CACHE $HF_DATASETS_CACHE \
         $TORCH_HOME $TRITON_CACHE_DIR $PIP_CACHE_DIR $TMPDIR

# gpuhopper has no internet — force HF offline mode.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

# Bind thread counts to the allocated CPU slice.
export OMP_NUM_THREADS=${PBS_NCPUS:-12}
export MKL_NUM_THREADS=${PBS_NCPUS:-12}

# Self-resubmitting cond-B OT annotation at n=10K. Pre-seeded with the 1,894
# rows already annotated at n=2K (cp'd into results/phase2/annot_ot_condB_n10k/
# matrices.jsonl before first shard). Batched OT at ~2s/sentence, remaining
# ~7,673 rows -> ~4h total -> ~2 shards.

OUTPUT_DIR=results/phase2/annot_ot_condB_n10k
mkdir -p "$OUTPUT_DIR"
SHARD_COUNTER_FILE="$OUTPUT_DIR/shard_counter"
SHARD_N=$(cat "$SHARD_COUNTER_FILE" 2>/dev/null || echo 0)
SHARD_N=$((SHARD_N + 1))
echo "$SHARD_N" > "$SHARD_COUNTER_FILE"
MAX_SHARDS=10

# --- CHAIN THE NEXT SHARD BEFORE RUNNING PYTHON ---
# PBS SIGKILLs the wrapper on walltime, so a *post-python* qsub is lost.
# Instead: qsub the next shard NOW with a dependency on this job's exit.
# The next shard's first act is to check for DONE; if present it exits
# cleanly without processing anything. Otherwise it picks up from where
# --resume can see. Also skip chaining if DONE already exists (nothing to do).
cd /g/data/ba39/dipankar/simt-tor-26
if [ ! -f "$OUTPUT_DIR/DONE" ] && [ "$SHARD_N" -lt "$MAX_SHARDS" ]; then
    NEXT_JOB=$(qsub -W depend=afterany:$PBS_JOBID jobs/phase2_annot_ot_condB_n10k_shard.pbs)
    echo "======================================================"
    echo "Shard $SHARD_N of $MAX_SHARDS. Next shard queued: $NEXT_JOB"
    echo "  (afterany dep on $PBS_JOBID — will run whether we exit clean or PBS kills us)"
    echo "======================================================"
else
    echo "======================================================"
    echo "Shard $SHARD_N: DONE marker already present or MAX_SHARDS reached — no chaining."
    echo "======================================================"
fi

python -u scripts/phase1_tau_sweep.py \
    --criterion ot \
    --taus 0.30,0.50,0.70,1.00 \
    --max_src_tokens 80 \
    --prompt_mode raw \
    --model_path /g/data/po67/dipankar/models/gemma-4-E2B \
    --output_dir "$OUTPUT_DIR" \
    --indices_file results/phase2/phase2_n10k_indices.json \
    --resume || echo "python exited non-zero (possibly PBS walltime — --resume picks up in the chained shard)"

if [ -f "$OUTPUT_DIR/DONE" ]; then
    echo "======================================================"
    echo "DONE after shard $SHARD_N — annotation complete."
    echo "  (chained shard $NEXT_JOB will start, see DONE, exit clean)"
    echo "======================================================"
fi
