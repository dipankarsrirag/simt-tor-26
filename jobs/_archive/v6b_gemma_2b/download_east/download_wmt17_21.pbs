#!/bin/bash
#PBS -N dl_wmt17_21
#PBS -P ba39
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l jobfs=10GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/dl_wmt17_21.log

set -o pipefail
cd /tmp
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

DEEN=/g/data/ba39/dipankar/simul-mt/data/eval/de-en
RUEN=/g/data/ba39/dipankar/simul-mt/data/eval/ru-en
mkdir -p $DEEN $RUEN

# sacrebleu ships newstest downloads; simpler than fetching each URL
for YEAR in 17 18 19 20 21; do
    YYYY=20$YEAR
    for PAIR in de-en en-de ru-en en-ru; do
        SRC_LANG=${PAIR%-*}; TGT_LANG=${PAIR#*-}
        if [ "$PAIR" = "de-en" ] || [ "$PAIR" = "en-de" ]; then DEST=$DEEN; else DEST=$RUEN; fi
        OUT_SRC=$DEST/wmt${YEAR}.${PAIR}.src
        OUT_REF=$DEST/wmt${YEAR}.${PAIR}.ref
        if [ -f "$OUT_SRC" ] && [ -f "$OUT_REF" ]; then
            echo "SKIP wmt${YEAR} ${PAIR} (exists)"
            continue
        fi
        echo "Downloading wmt${YEAR} ${PAIR} ..."
        python3 -c "
import sacrebleu
try:
    src = sacrebleu.utils.smart_open(sacrebleu.utils.get_source_file(f'wmt${YEAR}', '${SRC_LANG}-${TGT_LANG}'))
    ref = sacrebleu.utils.smart_open(sacrebleu.utils.get_reference_files(f'wmt${YEAR}', '${SRC_LANG}-${TGT_LANG}')[0])
    with open('$OUT_SRC', 'w') as f:
        f.write(src.read())
    with open('$OUT_REF', 'w') as f:
        f.write(ref.read())
    print(f'  OK $OUT_SRC and $OUT_REF')
except Exception as e:
    print(f'  FAIL: {type(e).__name__}: {e}')
" 2>&1
    done
done

echo ""
echo "=== Final WMT test files on disk ==="
ls -la $DEEN/wmt1[7-9].de-en.* $DEEN/wmt2[01].de-en.* $DEEN/wmt1[7-9].en-de.* $DEEN/wmt2[01].en-de.* 2>/dev/null
ls -la $RUEN/wmt1[7-9].*.* $RUEN/wmt2[01].*.* 2>/dev/null
