#!/bin/bash
#PBS -N phase2_annot_ot_condB_qwen_n10k
#PBS -P po67
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=02:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/phase2_annot_ot_condB_qwen_n10k.log

# Qwen3.5-2B OT annotation on the same 9,567 indices as Gemma cond-B, for
# cross-family replication. Chain-at-START pattern for self-resubmit.

set -eo pipefail
mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs

export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export HF_DATASETS_CACHE=/g/data/po67/dipankar/cache/datasets
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export TRITON_CACHE_DIR=/g/data/po67/dipankar/cache/triton
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export PIP_CACHE_DIR=/g/data/po67/dipankar/cache/pip
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $HF_HOME $HF_HUB_CACHE $TRANSFORMERS_CACHE $HF_DATASETS_CACHE \
         $TORCH_HOME $TRITON_CACHE_DIR $PIP_CACHE_DIR $TMPDIR

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

export OMP_NUM_THREADS=${PBS_NCPUS:-12}
export MKL_NUM_THREADS=${PBS_NCPUS:-12}

OUTPUT_DIR=results/phase2/annot_ot_condB_qwen35_n10k
mkdir -p "$OUTPUT_DIR"
SHARD_COUNTER_FILE="$OUTPUT_DIR/shard_counter"
SHARD_N=$(cat "$SHARD_COUNTER_FILE" 2>/dev/null || echo 0)
SHARD_N=$((SHARD_N + 1))
echo "$SHARD_N" > "$SHARD_COUNTER_FILE"
MAX_SHARDS=10

if [ ! -f "$OUTPUT_DIR/DONE" ] && [ "$SHARD_N" -lt "$MAX_SHARDS" ]; then
    NEXT_JOB=$(qsub -W depend=afterany:$PBS_JOBID jobs/phase2_annot_ot_condB_qwen_n10k_shard.pbs)
    echo "======================================================"
    echo "Shard $SHARD_N of $MAX_SHARDS. Next shard queued: $NEXT_JOB"
    echo "======================================================"
fi

python -u scripts/phase1_tau_sweep.py \
    --criterion ot \
    --taus 0.30,0.50,0.70,1.00 \
    --max_src_tokens 80 \
    --prompt_mode raw \
    --model_path /g/data/po67/dipankar/models/Qwen3.5-2B \
    --output_dir "$OUTPUT_DIR" \
    --indices_file results/phase2/phase2_n10k_indices.json \
    --resume || echo "python exited non-zero (possibly PBS walltime — --resume picks up in the chained shard)"

if [ -f "$OUTPUT_DIR/DONE" ]; then
    echo "DONE after shard $SHARD_N — annotation complete."
fi
