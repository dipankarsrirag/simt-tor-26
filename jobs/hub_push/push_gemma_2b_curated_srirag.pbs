#!/bin/bash
#PBS -N hub_push_gemma_2b_srirag
#PBS -P ba39
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l jobfs=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/hub_push_gemma_2b_srirag.log

# Sibling to push_gemma_2b_curated.pbs — same artifacts, srirag/ personal
# namespace instead of unswnlporg/. All defaults resolve from the config's
# tag; no path overrides needed.

set -eo pipefail
cd /g/data/ba39/dipankar/simt-tor-26

export SIMT_REPO_ROOT=/g/data/ba39/dipankar/simt-tor-26
source jobs/env.sh

export HF_TOKEN=$(python3 -c "
import sys
sys.path.insert(0, '/g/data/po67/dipankar/models')
from get_model import HF_TOKEN
print(HF_TOKEN)
")

python3 -u "$SIMT_REPO_ROOT/scripts/11_push_to_hub.py" \
    --config "$SIMT_REPO_ROOT/configs/00_gemma_2b_curated.yaml" \
    --org srirag

echo ""
echo "Done. See https://huggingface.co/srirag/tor-simt-gemma-2b-curated"
