#!/bin/bash
#PBS -N hub_push_gemma_2b
#PBS -P ba39
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l jobfs=100GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/hub_push_gemma_2b.log

# Push the shipped Gemma-2B baseline (config 00) to unswnlporg/tor-simt-
# gemma-2b-curated. All artifacts live at canonical paths under
# results/{train,eval,sft_dataset,annotate}/gemma_2b_curated/ and logs/
# gemma_2b_curated/ — no --model_dir/--eval_dir/--log_dir/--source_pool
# overrides needed. The push script picks up all defaults from the config's
# tag.

set -eo pipefail
cd /g/data/ba39/dipankar/simt-tor-26

export SIMT_REPO_ROOT=/g/data/ba39/dipankar/simt-tor-26
source jobs/env.sh

# HF token at runtime (never written to disk/git)
export HF_TOKEN=$(python3 -c "
import sys
sys.path.insert(0, '/g/data/po67/dipankar/models')
from get_model import HF_TOKEN
print(HF_TOKEN)
")

python3 -u "$SIMT_REPO_ROOT/scripts/11_push_to_hub.py" \
    --config "$SIMT_REPO_ROOT/configs/00_gemma_2b_curated.yaml"

echo ""
echo "Done. See https://huggingface.co/unswnlporg/tor-simt-gemma-2b-curated"
