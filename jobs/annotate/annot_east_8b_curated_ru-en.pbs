#!/bin/bash
#PBS -N annot_east_8b_curated_ru-en
#PBS -P ba39
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/ba39+gdata/po67+scratch/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/annot_east_8b_curated_ru-en.log

# OT annotation for config east_8b_curated on direction ru-en. Self-annotation
# with Meta-Llama-3-8B-Instruct. Reuses the 80K shipped curated source pool via symlink
# at results/sft_dataset/east_8b_curated/per_direction/ru-en.json.
# Output: results/annotate/Meta-Llama-3-8B-Instruct/ru-en/matrices.jsonl (~10K rows).
# --resume: safe to re-queue on walltime; picks up where left off.

set -eo pipefail
cd /g/data/ba39/dipankar/simt-tor-26
export SIMT_REPO_ROOT=/g/data/ba39/dipankar/simt-tor-26
source jobs/env.sh

python3 -u scripts/07_annotate.py \
    --input_json  results/sft_dataset/east_8b_curated/per_direction/ru-en.json \
    --model_path  /g/data/po67/dipankar/models/Meta-Llama-3-8B-Instruct \
    --output_dir  results/annotate/Meta-Llama-3-8B-Instruct/ru-en \
    --criterion   ot \
    --taus        0.30 \
    --lookahead_k 0 \
    --prompt_mode chat \
    --resume
