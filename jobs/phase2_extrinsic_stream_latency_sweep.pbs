#!/bin/bash
#PBS -N phase2_extrinsic_stream_latency_sweep
#PBS -P po67
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=05:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/phase2_extrinsic_stream_latency_sweep_${MODEL_ARM}.log

# EAST-style Table 1/3: per-latency-prompt (low/medium/high) sweep at
# wait_k=5 (representative point on the curve) + check_argmax.
# 2 policies × 3 latencies × 3000 sents. Streaming eval only — offline
# under 3 latencies would be a separate run.

set -eo pipefail
mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs

export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export HF_DATASETS_CACHE=/g/data/po67/dipankar/cache/datasets
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export TRITON_CACHE_DIR=/g/data/po67/dipankar/cache/triton
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export PIP_CACHE_DIR=/g/data/po67/dipankar/cache/pip
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $HF_HOME $HF_HUB_CACHE $TRANSFORMERS_CACHE $HF_DATASETS_CACHE \
         $TORCH_HOME $TRITON_CACHE_DIR $PIP_CACHE_DIR $TMPDIR

export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

export OMP_NUM_THREADS=${PBS_NCPUS:-12}
export MKL_NUM_THREADS=${PBS_NCPUS:-12}

: ${MODEL_ARM:?MODEL_ARM env var required (condA or condB)}
MODEL=results/phase2/sft_${MODEL_ARM}_n10k/final
DEV_DIR=/g/data/po67/dipankar/data/simt-tor-26/wmt13-de-en
OUT=results/phase2/extrinsic

for LAT in low high; do
    # wait_k=5 is representative on the AL curve.
    OUT_FILE="$OUT/full_stream_waitk5_lat${LAT}_${MODEL_ARM}_n10k.json"
    if [ ! -f "$OUT_FILE" ]; then
        echo "===== ${MODEL_ARM} | wait_k=5 | latency=${LAT} ====="
        python -u src/eval/extrinsic.py \
            --model_dir "$MODEL" \
            --dev_src "$DEV_DIR/newstest2013.de" \
            --dev_ref "$DEV_DIR/newstest2013.en" \
            --latency ${LAT} \
            --mode streaming --policy wait_k --wait_k 5 \
            --output "$OUT_FILE"
    fi
    OUT_FILE="$OUT/full_stream_checkargmax_lat${LAT}_${MODEL_ARM}_n10k.json"
    if [ ! -f "$OUT_FILE" ]; then
        echo "===== ${MODEL_ARM} | check_argmax | latency=${LAT} ====="
        python -u src/eval/extrinsic.py \
            --model_dir "$MODEL" \
            --dev_src "$DEV_DIR/newstest2013.de" \
            --dev_ref "$DEV_DIR/newstest2013.en" \
            --latency ${LAT} \
            --mode streaming --policy check_argmax \
            --output "$OUT_FILE"
    fi
done
