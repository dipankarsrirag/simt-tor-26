#!/bin/bash
#PBS -N phase2_extrinsic_streaming_smoke
#PBS -P po67
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=240GB
#PBS -l jobfs=120GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/phase2_extrinsic_streaming_smoke.log

# Queue: gpuhopper | GPU: H200-141GB x1
# Layer 2 GPU smoke: 100 sents newstest2013, three runs per model —
#   (1) wait_k=3 AL unit test — corpus AL should land near 3.
#   (2) wait_k=5 AL unit test — corpus AL should land near 5.
#   (3) check_argmax model-driven policy — the paper number.
# Runs on cond-A only (10K matched to prior offline BLEU 32.41). If AL for
# wait-k is right and check_argmax BLEU is within a few points of 32.4,
# green-light Layer 2 for cond-B and full 3000-sent runs.

set -eo pipefail
mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs

# Shared po67 cache — persists across scratch purges, shared with sibling projects.
export HF_HOME=/g/data/po67/dipankar/cache
export HF_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export HUGGINGFACE_HUB_CACHE=/g/data/po67/dipankar/cache/hub
export TRANSFORMERS_CACHE=/g/data/po67/dipankar/cache/transformers
export HF_DATASETS_CACHE=/g/data/po67/dipankar/cache/datasets
export TORCH_HOME=/g/data/po67/dipankar/cache/torch
export TRITON_CACHE_DIR=/g/data/po67/dipankar/cache/triton
export XDG_CACHE_HOME=/g/data/po67/dipankar/cache
export PIP_CACHE_DIR=/g/data/po67/dipankar/cache/pip
export TMPDIR=/g/data/po67/dipankar/cache/tmp
mkdir -p $HF_HOME $HF_HUB_CACHE $TRANSFORMERS_CACHE $HF_DATASETS_CACHE \
         $TORCH_HOME $TRITON_CACHE_DIR $PIP_CACHE_DIR $TMPDIR

# gpuhopper has no internet — force HF offline mode.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

cd /g/data/ba39/dipankar/simt-tor-26
module load python3/3.10.4
source /scratch/po67/ds9561/.venv-fil/bin/activate

# Bind thread counts to the allocated CPU slice.
export OMP_NUM_THREADS=${PBS_NCPUS:-12}
export MKL_NUM_THREADS=${PBS_NCPUS:-12}

DEV_DIR=/g/data/po67/dipankar/data/simt-tor-26/wmt13-de-en
MODEL=results/phase2/sft_condA_n10k/final

echo "===== SMOKE 1: wait_k=3 on cond-A/n=10K (AL unit test — target ~3) ====="
python -u src/eval/extrinsic.py \
    --model_dir "$MODEL" \
    --dev_src "$DEV_DIR/newstest2013.de" \
    --dev_ref "$DEV_DIR/newstest2013.en" \
    --latency medium \
    --n_sentences 100 \
    --mode streaming --policy wait_k --wait_k 3 \
    --output results/phase2/extrinsic/smoke_stream_waitk3_condA_n10k.json

echo "===== SMOKE 2: wait_k=5 on cond-A/n=10K (AL unit test — target ~5) ====="
python -u src/eval/extrinsic.py \
    --model_dir "$MODEL" \
    --dev_src "$DEV_DIR/newstest2013.de" \
    --dev_ref "$DEV_DIR/newstest2013.en" \
    --latency medium \
    --n_sentences 100 \
    --mode streaming --policy wait_k --wait_k 5 \
    --output results/phase2/extrinsic/smoke_stream_waitk5_condA_n10k.json

echo "===== SMOKE 3: check_argmax on cond-A/n=10K (model-driven policy) ====="
python -u src/eval/extrinsic.py \
    --model_dir "$MODEL" \
    --dev_src "$DEV_DIR/newstest2013.de" \
    --dev_ref "$DEV_DIR/newstest2013.en" \
    --latency medium \
    --n_sentences 100 \
    --mode streaming --policy check_argmax \
    --output results/phase2/extrinsic/smoke_stream_checkargmax_condA_n10k.json
