#!/bin/bash
#PBS -N download_gemma4_e4b_base
#PBS -P po67
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=32GB
#PBS -l walltime=03:00:00
#PBS -l storage=gdata/ba39+gdata/po67
#PBS -l wd
#PBS -j oe
#PBS -k oed
#PBS -o /g/data/ba39/dipankar/simt-tor-26/logs/download_gemma4_e4b_base.log

# Download Gemma-4-E4B BASE (not -it — see LOG.md 2026-08-14 backbone decision).
# Only -it variant currently on disk; base needed for scale-up A/B on Phase 2.

mkdir -p /g/data/ba39/dipankar/simt-tor-26/logs
module load python3/3.10.4
source /g/data/ba39/dipankar/.venv/bin/activate

SCRIPT=/g/data/po67/dipankar/models/get_model.py
DEST=/g/data/po67/dipankar/models/gemma-4-E4B

python "$SCRIPT" google/gemma-3n-E4B model "$DEST"

# Sanity: list what landed.
ls -la "$DEST"
du -sh "$DEST"
